# InferMesh Core Settings
ENVIRONMENT=production-us-east-1
PORT=8000
HOST=0.0.0.0
DEBUG=false

# Security & JWT
SECRET_KEY=infermesh_super_secret_jwt_key_securerandom_32_chars
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database (Defaults to SQLite for instant local standalone run)
DATABASE_URL=sqlite+aiosqlite:///./infermesh.db
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/infermesh

# Redis (Optional)
# REDIS_URL=redis://localhost:6379/0

# Observability Pipelines
PROMETHEUS_URL=http://localhost:9090
LOKI_URL=http://localhost:3100
JAEGER_URL=http://localhost:16686

# Data Retention Settings
METRIC_RETENTION_HOURS=72
LOG_RETENTION_DAYS=14
TRACE_RETENTION_DAYS=7
INCIDENT_RETENTION_DAYS=90

# Frontend Next.js Public Endpoints
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws
